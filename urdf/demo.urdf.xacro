<?xml version="1.0"?>
<!-- demo: a Livox lidar (model:=mid360 or hap) on top of a 1 m pole fixed to the world -->
<robot name="livox_demo" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="model" default="mid360"/>
  <xacro:arg name="xfer_format" default="0"/>
  <xacro:arg name="publish_freq" default="10.0"/>
  <xacro:arg name="slices" default="1"/>
  <xacro:arg name="resolution" default="0.2"/>
  <xacro:arg name="downsample" default="1"/>
  <xacro:include filename="$(find livox_gz_sim)/urdf/mid360.xacro"/>
  <xacro:include filename="$(find livox_gz_sim)/urdf/hap.xacro"/>

  <link name="world"/>
  <joint name="pole_joint" type="fixed">
    <parent link="world"/>
    <child link="pole"/>
  </joint>
  <link name="pole">
    <visual>
      <origin xyz="0 0 0.5"/>
      <geometry><cylinder radius="0.02" length="1.0"/></geometry>
      <material name="pole_grey"><color rgba="0.6 0.6 0.62 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.5"/>
      <geometry><cylinder radius="0.02" length="1.0"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.5"/>
      <mass value="1.0"/>
      <inertia ixx="0.083" iyy="0.083" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <xacro:if value="${'$(arg model)' == 'mid360'}">
    <xacro:mid360 parent="pole" xfer_format="$(arg xfer_format)" publish_freq="$(arg publish_freq)"
                  slices="$(arg slices)" resolution="$(arg resolution)" downsample="$(arg downsample)">
      <origin xyz="0 0 1.0"/>
    </xacro:mid360>
  </xacro:if>
  <!-- the HAP looks along +X, at the box and the far wall -->
  <xacro:if value="${'$(arg model)' == 'hap'}">
    <xacro:hap parent="pole" xfer_format="$(arg xfer_format)" publish_freq="$(arg publish_freq)"
               slices="$(arg slices)" resolution="$(arg resolution)" downsample="$(arg downsample)">
      <origin xyz="0 0 1.0"/>
    </xacro:hap>
  </xacro:if>
</robot>
