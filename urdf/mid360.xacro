<?xml version="1.0"?>
<!-- Livox Mid-360. Dimensions and the point cloud origin from the Mid-360 User
     Manual (appendix drawing): 65 x 65 x 60 mm, 265 g, origin O 47 mm above the
     bottom on the axis, +X on the logo side (the cable connector is on -X). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mid360" params="parent *origin name:=livox topic:=livox/lidar">
    <!-- origin: the centre of the sensor's bottom face -->
    <joint name="${name}_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <link name="${name}_base_link">
      <visual>
        <geometry><mesh filename="package://livox_gz_sim/meshes/mid360.dae"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0.030"/>
        <geometry><box size="0.065 0.065 0.060"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.030"/>
        <mass value="0.265"/>
        <!-- solid box 65 x 65 x 60 mm -->
        <inertia ixx="1.73e-4" iyy="1.73e-4" izz="1.87e-4" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_frame_joint" type="fixed">
      <parent link="${name}_base_link"/>
      <child link="${name}_frame"/>
      <origin xyz="0 0 0.047"/>
    </joint>
    <link name="${name}_frame"/>

    <!-- a plain grid lidar over the Mid-360's field of view for now:
         360 deg x -7..52 deg, 0.1-40 m, 10 Hz, ~20k points per frame
         (the real sensor gives 200k points/s) -->
    <gazebo reference="${name}_frame">
      <sensor name="${name}" type="gpu_lidar">
        <topic>${topic}</topic>
        <gz_frame_id>${name}_frame</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>60</samples>
              <min_angle>-0.12217</min_angle>
              <max_angle>0.90757</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40.0</max>
            <resolution>0.002</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
