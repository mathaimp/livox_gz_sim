<?xml version="1.0"?>
<!-- Livox Mid-360 with its real (non-repetitive) scan pattern.

       <xacro:include filename="$(find livox_gz_sim)/urdf/mid360.xacro"/>
       <xacro:mid360 parent="base_link">
         <origin xyz="..." rpy="..."/>
       </xacro:mid360>

     The origin places the centre of the sensor's bottom face. Dimensions and the
     point cloud origin from the Mid-360 User Manual (appendix drawing): 65 x 65 x 60
     mm, 265 g, origin O 47 mm above the bottom on the axis, +X on the logo side
     (the cable connector is on -X). FOV 360 deg x -7..52 deg, 0.1-40 m (10 %
     reflectivity), 200k points/s at 10 Hz.

     Gazebo: a dense gpu_lidar (0.2 deg grid) renders a range image and the
     livox_gz_sim::LivoxLidar plugin samples it along Livox's recorded Mid-360
     pattern, 20k rays per 10 Hz frame, so coverage builds up over frames as on the
     real sensor. It publishes as livox_ros_driver2 does, on ${topic} in ${name}_frame:
       xfer_format 0 = sensor_msgs/PointCloud2 (x y z intensity tag line timestamp)
                   1 = livox_ros_driver2/CustomMsg (as for FAST-LIO)
     The built-in IMU, also as the driver: sensor_msgs/Imu on ${imu_topic} at 200 Hz,
     in ${name}_frame (axes aligned with it), acceleration in g. It sits at
     ${name}_imu_link, (11.0, 23.29, -44.12) mm from the point cloud origin (manual),
     so FAST-LIO's extrinsic_T is [-0.011, -0.02329, 0.04412], extrinsic_R identity.
     Needs the world's gz-sim-imu-system. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mid360" params="parent *origin name:=livox topic:=livox/lidar xfer_format:=0 imu_topic:=livox/imu">
    <joint name="${name}_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <link name="${name}_base_link">
      <visual>
        <geometry><mesh filename="package://livox_gz_sim/meshes/mid360.dae"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0.030"/>
        <geometry><box size="0.065 0.065 0.060"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.030"/>
        <mass value="0.265"/>
        <!-- solid box 65 x 65 x 60 mm -->
        <inertia ixx="1.73e-4" iyy="1.73e-4" izz="1.87e-4" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_frame_joint" type="fixed">
      <parent link="${name}_base_link"/>
      <child link="${name}_frame"/>
      <origin xyz="0 0 0.047"/>
    </joint>
    <link name="${name}_frame"/>

    <gazebo reference="${name}_frame">
      <sensor name="${name}" type="gpu_lidar">
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <!-- the dense image, gz only; the plugin publishes ${topic} -->
        <topic>${name}/dense_scan</topic>
        <gz_frame_id>${name}_frame</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1801</samples>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
            <!-- covers the pattern's -7.2..52.2 deg -->
            <vertical>
              <samples>300</samples>
              <min_angle>${radians(-7.4)}</min_angle>
              <max_angle>${radians(52.4)}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40.0</max>
            <resolution>0.001</resolution>
          </range>
          <!-- datasheet range precision 2 cm (1 sigma) at 10 m -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
        <plugin filename="livox_gz_sim" name="livox_gz_sim::LivoxLidar">
          <pattern>mid360.csv</pattern>
          <samples>20000</samples>
          <point_rate>200000</point_rate>
          <line_count>4</line_count>
          <topic>${topic}</topic>
          <frame_id>${name}_frame</frame_id>
          <xfer_format>${xfer_format}</xfer_format>
          <!-- datasheet angular random error (1 sigma) -->
          <angular_noise>0.15</angular_noise>
        </plugin>
      </sensor>
    </gazebo>

    <joint name="${name}_imu_joint" type="fixed">
      <parent link="${name}_frame"/>
      <child link="${name}_imu_link"/>
      <origin xyz="0.011 0.02329 -0.04412"/>
    </joint>
    <link name="${name}_imu_link"/>

    <gazebo reference="${name}_imu_link">
      <sensor name="${name}_imu" type="imu">
        <update_rate>200</update_rate>
        <always_on>true</always_on>
        <!-- gz only; the plugin publishes ${imu_topic} -->
        <topic>${name}/imu_raw</topic>
        <!-- white noise of the ICM-40609 (TDK datasheet DS-000330 v1.2, tables 1 and 2):
             RMS noise at 100 Hz bandwidth (the Nyquist band of the 200 Hz output),
             gyro 0.045 deg/s = 7.9e-4 rad/s, accel 1.00 mg = 9.8e-3 m/s^2. No bias. -->
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>7.9e-4</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>7.9e-4</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>7.9e-4</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>9.8e-3</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>9.8e-3</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>9.8e-3</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin filename="livox_gz_sim" name="livox_gz_sim::LivoxImu">
          <topic>${imu_topic}</topic>
          <frame_id>${name}_frame</frame_id>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
